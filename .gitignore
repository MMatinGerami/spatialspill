# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.hypothesis/
.ipynb_checkpoints/

# Data: raw and processed are regenerated by scripts/download_*.py; only data/bundled is tracked
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.h5ad
*.h5mu
*.h5
!data/bundled/*.h5mu
!data/bundled/*.h5ad

# Results: large intermediate artefacts are ignored, figures/tables referenced from docs are tracked
results/**/*.pt
results/**/*.pkl
results/**/*.npz
results/**/cache/

# LaTeX
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# OS / editors
.DS_Store
.vscode/
.idea/

# per-estimate tables are regenerated by the pipeline; summaries and figures are tracked
results/**/*_estimates.csv
paper/main.pdf
